# MCP server (services/mcp) on Cloud Run as sky-mcp, which can read only the
# BigQuery public dataset. Read-only tools are public; run_sql also needs the
# token in Secret Manager (sent as the X-Sky-Scanner-Token header).

# Generated by Terraform, so the token sits in the (private) state bucket. It
# only unlocks capped, read-only SQL over public data; read it with
#   gcloud secrets versions access latest --secret mcp-sql-token
resource "random_password" "mcp_sql_token" {
  length  = 40
  special = false
}

resource "google_secret_manager_secret" "mcp_sql_token" {
  secret_id = "mcp-sql-token"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "mcp_sql_token" {
  secret      = google_secret_manager_secret.mcp_sql_token.id
  secret_data = random_password.mcp_sql_token.result
}

resource "google_secret_manager_secret_iam_member" "mcp_reads_sql_token" {
  secret_id = google_secret_manager_secret.mcp_sql_token.id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.this["mcp"].email}"
}

resource "google_cloud_run_v2_service" "mcp" {
  name                = "mcp"
  location            = var.region
  ingress             = "INGRESS_TRAFFIC_ALL"
  deletion_protection = false
  labels              = { component = "mcp" }

  template {
    service_account                  = google_service_account.this["mcp"].email
    max_instance_request_concurrency = 40

    scaling {
      # Scale to zero: MCP clients tolerate a cold start of a few seconds.
      min_instance_count = 0
      max_instance_count = 2
    }

    containers {
      image = var.mcp_image
      ports {
        container_port = 8080
      }
      env {
        name  = "GCP_PROJECT"
        value = var.project_id
      }
      env {
        name  = "PUBLIC_DATASET"
        value = google_bigquery_dataset.this["public"].dataset_id
      }
      env {
        name = "MCP_SQL_TOKEN"
        value_source {
          secret_key_ref {
            secret  = google_secret_manager_secret.mcp_sql_token.secret_id
            version = "latest"
          }
        }
      }
      resources {
        limits   = { cpu = "1", memory = "512Mi" }
        cpu_idle = true
      }
      startup_probe {
        http_get {
          path = "/health"
        }
      }
    }
  }

  depends_on = [google_secret_manager_secret_iam_member.mcp_reads_sql_token,
  google_secret_manager_secret_version.mcp_sql_token]

  lifecycle {
    ignore_changes = [template[0].containers[0].image, client, client_version]
  }
}

resource "google_cloud_run_v2_service_iam_member" "mcp_public" {
  name     = google_cloud_run_v2_service.mcp.name
  location = var.region
  role     = "roles/run.invoker"
  member   = "allUsers"
}

resource "google_cloud_run_domain_mapping" "mcp" {
  count    = var.mcp_domain == "" ? 0 : 1
  name     = var.mcp_domain
  location = var.region

  metadata {
    namespace = var.project_id
  }
  spec {
    route_name = google_cloud_run_v2_service.mcp.name
  }
}

output "mcp_url" {
  value = "${google_cloud_run_v2_service.mcp.uri}/mcp"
}
